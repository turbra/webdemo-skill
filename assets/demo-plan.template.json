{
  "name": "Example website",
  "slug": "example-site-demo",
  "siteRoot": ".",
  "output": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "background": "#111827"
  },
  "segments": [
    {
      "name": "Desktop overview",
      "viewport": {
        "width": 1920,
        "height": 1080
      },
      "presentation": "fit",
      "startPath": "/",
      "readySelector": "main",
      "actions": [
        {
          "type": "chapter",
          "title": "Example website",
          "description": "Desktop experience",
          "duration": 1200
        },
        {
          "type": "scroll",
          "selector": "main section:nth-of-type(2)",
          "block": "center",
          "pause": 1500
        }
      ]
    },
    {
      "name": "Mobile overview",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "presentation": "phone",
      "startPath": "/",
      "readySelector": "main",
      "actions": [
        {
          "type": "chapter",
          "title": "Mobile experience",
          "description": "Responsive navigation and content",
          "duration": 1200
        },
        {
          "type": "scroll",
          "selector": "main section:nth-of-type(2)",
          "block": "center",
          "pause": 1500
        }
      ]
    }
  ]
}
